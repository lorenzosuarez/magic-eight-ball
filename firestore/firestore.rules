rules_version = '2';

// What the app keeps in Cloud Firestore: one document to an account, its profile, at
// users/{the account's id}, and under it the characters that account made up, at most five.
// Whoever is signed in reads and writes their own and nothing else; what is not allowed here is
// refused. Checked by firestore/rules_test.py.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Rules have no padding of their own.
    function twoDigits(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    // The latest date of birth an adult can have, written as dates are kept. Counted from
    // tomorrow by the server's clock, so that nobody who is 18 where they are is refused for
    // living ahead of it. The app checks the same on the device, to the day.
    function latestAdultBirthDate() {
      let limit = request.time + duration.value(1, 'd');
      return string(limit.year() - 18) + '-' + twoDigits(limit.month()) + '-' + twoDigits(limit.day());
    }

    // A profile is these three fields and no other: nothing the app does not ask for can be
    // kept here, and nothing else can be slipped in beside it.
    function isProfile(data) {
      return data.keys().hasOnly(['firstName', 'birthDate', 'consent'])
        && data.keys().hasAll(['firstName', 'birthDate', 'consent'])
        && data.firstName is string
        && data.firstName.size() >= 1
        // Twenty characters, as the app counts them. Here a character from beyond the common
        // ones counts as two, so twice as many are let through: the app holds the tighter line.
        && data.firstName.size() <= 40
        && data.birthDate is string
        // A year of the last two centuries, a month and a day that can be one.
        && data.birthDate.matches('^(19|20)[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && data.birthDate <= latestAdultBirthDate()
        // The record of the user's agreement: which wording, and when.
        && data.consent is map
        && data.consent.keys().hasOnly(['version', 'at'])
        && data.consent.keys().hasAll(['version', 'at'])
        && data.consent.version is int
        && data.consent.version >= 1
        && data.consent.at is timestamp;
    }

    // An agreement is dated by the server's clock, as it is made: the app cannot set it to a
    // time of its choosing.
    function isAgreedNow(data) {
      return data.consent.at == request.time;
    }

    // No character is left once the request has been made: a profile goes with the characters
    // kept under it, in one change, or not at all. Left behind, they could be reached by nobody.
    function leavesNoCharacter(uid) {
      return !existsAfter(/databases/$(database)/documents/users/$(uid)/characters/1)
        && !existsAfter(/databases/$(database)/documents/users/$(uid)/characters/2)
        && !existsAfter(/databases/$(database)/documents/users/$(uid)/characters/3)
        && !existsAfter(/databases/$(database)/documents/users/$(uid)/characters/4)
        && !existsAfter(/databases/$(database)/documents/users/$(uid)/characters/5);
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow delete: if isOwner(uid) && leavesNoCharacter(uid);
      allow create: if isOwner(uid) && isProfile(request.resource.data) && isAgreedNow(request.resource.data);
      // A correction leaves the agreement as it was made, or makes it anew: never anything else.
      allow update: if isOwner(uid) && isProfile(request.resource.data)
        && (request.resource.data.consent == resource.data.consent || isAgreedNow(request.resource.data));

      // The characters this account made up, one to a slot. The slots are named "1" to "5" and
      // no other name is allowed: that, and not the app, is what keeps an account to five.
      match /characters/{slot} {
        allow read, delete: if isOwner(uid);
        // Only for an account that has its profile, which is where its owner agreed to what
        // is sent of a character to the AI service.
        allow create, update: if isOwner(uid)
          && slot.matches('^[1-5]$')
          && isCharacter(request.resource.data)
          && exists(/databases/$(database)/documents/users/$(uid));
      }
    }

    // A character is these four fields and no other: a name, how it answers, and whose colour
    // and whose accessory it borrows among the app's own, by their names in lower case.
    function isCharacter(data) {
      return data.keys().hasOnly(['name', 'description', 'colour', 'emblem'])
        && data.keys().hasAll(['name', 'description', 'colour', 'emblem'])
        // Sixteen characters and two hundred and eighty, as the app counts them: twice as many
        // here, where a character from beyond the common ones counts as two.
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 32
        && data.description is string
        && data.description.size() >= 1
        && data.description.size() <= 560
        && data.colour is string
        && data.colour.matches('^[a-z]{1,16}$')
        && data.emblem is string
        && data.emblem.matches('^[a-z]{1,16}$');
    }
  }
}
