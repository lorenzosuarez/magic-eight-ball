rules_version = '2';

// What the app keeps in Cloud Firestore: one document to an account, its profile, at
// users/{the account's id}. Whoever is signed in reads and writes their own and nothing else;
// what is not allowed here is refused. Checked by firestore/rules_test.py.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Rules have no padding of their own.
    function twoDigits(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    // The latest date of birth an adult can have, written as dates are kept. Counted from
    // tomorrow by the server's clock, so that nobody who is 18 where they are is refused for
    // living ahead of it. The app checks the same on the device, to the day.
    function latestAdultBirthDate() {
      let limit = request.time + duration.value(1, 'd');
      return string(limit.year() - 18) + '-' + twoDigits(limit.month()) + '-' + twoDigits(limit.day());
    }

    // A profile is these three fields and no other: nothing the app does not ask for can be
    // kept here, and nothing else can be slipped in beside it.
    function isProfile(data) {
      return data.keys().hasOnly(['firstName', 'birthDate', 'consent'])
        && data.keys().hasAll(['firstName', 'birthDate', 'consent'])
        && data.firstName is string
        && data.firstName.size() >= 1
        && data.firstName.size() <= 20
        && data.birthDate is string
        && data.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.birthDate <= latestAdultBirthDate()
        // The record of the user's agreement: which wording, and when by the server's clock,
        // which the app cannot set to a time of its choosing.
        && data.consent is map
        && data.consent.keys().hasOnly(['version', 'at'])
        && data.consent.keys().hasAll(['version', 'at'])
        && data.consent.version is int
        && data.consent.version >= 1
        && data.consent.at == request.time;
    }

    match /users/{uid} {
      allow get, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isProfile(request.resource.data);
    }
  }
}
